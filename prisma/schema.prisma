// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String        @id @default(cuid())
  nombre        String
  descripcion   String?
  stack         String[]
  estado        ProjectEstado @default(ACTIVO)
  area          ProjectArea?
  progreso      Int           @default(0)
  repoUrl       String?
  rutaLocal     String?
  ultimaNota    String?
  proximoPaso   String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
  notas         Note[]
  ideas         Idea[]        @relation("ProyectoIdeas")
  propuestas    Proposal[]
}

model Proposal {
  id             String         @id @default(cuid())
  nombreCliente  String
  clienteId      String?
  cliente        Client?        @relation(fields: [clienteId], references: [id])
  descripcion    String?
  monto          Float?
  estado         ProposalEstado @default(LEAD)
  ultimoContacto DateTime?
  notas          String?
  proyectoId     String?
  proyecto       Project?       @relation(fields: [proyectoId], references: [id])
  ingresos       Revenue[]
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  @@index([estado])
  @@index([clienteId])
}

model Client {
  id            String       @id @default(cuid())
  nombre        String
  marca         String?
  tipo          ClientTipo   @default(PERSONA)
  email         String?
  telefono      String?
  ciudad        String?
  propuestas    Proposal[]
  cotizaciones  Cotizacion[]
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
}

model Cotizacion {
  id            String           @id @default(cuid())
  clienteId     String?
  cliente       Client?          @relation(fields: [clienteId], references: [id])
  nombreCliente String
  estado        CotizacionEstado @default(BORRADOR)
  items         Json             @default("[]")
  total         Float            @default(0)
  notas         String?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  @@index([estado])
  @@index([clienteId])
}

model Pending {
  id          String    @id @default(cuid())
  texto       String
  completado  Boolean   @default(false)
  fechaLimite DateTime?
  estaSemana  Boolean   @default(true)
  fuente      String    @default("panel")
  creadoEn    DateTime  @default(now())

  @@index([completado, estaSemana])
}

model Idea {
  id                 String       @id @default(cuid())
  texto              String
  fuente             String       @default("panel")
  etiqueta           IdeaEtiqueta @default(IDEA)
  estado             IdeaEstado   @default(NUEVA)
  desarrollo         String?
  proximoPensamiento String?
  proyectoId         String?
  proyecto           Project?     @relation("ProyectoIdeas", fields: [proyectoId], references: [id])
  creadoEn           DateTime     @default(now())
  actualizadoEn      DateTime     @updatedAt

  @@index([estado, etiqueta])
  @@index([proyectoId])
}

model Note {
  id         String   @id @default(cuid())
  contenido  String
  proyectoId String
  proyecto   Project  @relation(fields: [proyectoId], references: [id])
  creadoEn   DateTime @default(now())

  @@index([proyectoId])
}

model InstagramSnapshot {
  id                 String   @id @default(cuid())
  seguidores         Int
  publicaciones      Int?
  alcancePromedio    Int?
  crecimientoSemanal Int?
  registradoEn       DateTime @default(now())
}

model Revenue {
  id          String    @id @default(cuid())
  monto       Float
  tipo        String    @default("INGRESO")   // "INGRESO" | "EGRESO"
  descripcion String?
  mes         Int
  anio        Int
  propuestaId String?
  propuesta   Proposal? @relation(fields: [propuestaId], references: [id])
  creadoEn    DateTime  @default(now())
}

enum ProjectEstado {
  ACTIVO
  PAUSADO
  COMPLETADO
  ARCHIVADO
}

enum ProjectArea {
  SALUD
  OFICIO
  RESTO
}

enum ProposalEstado {
  LEAD
  PROPUESTA
  ACTIVO
  CERRADO
}

enum ClientTipo {
  PERSONA
  EMPRESA
}

enum CotizacionEstado {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
}

enum IdeaEtiqueta {
  IDEA
  MEJORA
  OPORTUNIDAD
  TAREA
}

enum IdeaEstado {
  NUEVA
  EN_REVISION
  DESARROLLANDO
  COMPLETADA
  DESCARTADA
}

model Evento {
  id          String     @id @default(cuid())
  titulo      String
  fecha       DateTime
  hora        String?    // "HH:MM" — simple string, sin timezone headaches
  tipo        EventoTipo @default(REUNION)
  clienteId   String?
  descripcion String?
  creadoEn    DateTime   @default(now())

  @@index([fecha])
}

enum EventoTipo {
  REUNION
  LLAMADA
  ENTREGA
  OTRO
}
